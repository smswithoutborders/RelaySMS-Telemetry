VITE_APP_VERSION = v0.2.0
GENERATE_SOURCEMAP = false

PUBLIC_URL = http://localhost
VITE_APP_BASE_NAME = /dashboard

# Admin (Publisher REST) API. Keep it same-origin: session cookies are SameSite=strict.
VITE_APP_ADMIN_API= /v1/
# Dev server only: where /v1 is proxied to.
ADMIN_API_PROXY_TARGET= http://127.0.0.1:16000

# CARTO basemaps key for map labels (free: https://carto.com/basemaps/apikey). Maps render without labels if unset.
VITE_APP_CARTO_BASEMAPS_KEY=
