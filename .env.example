# Path the dashboard is served under, e.g. /dashboard. Leave empty to serve from the root.
VITE_BASE_PATH=

# Admin (Publisher REST) API base URL. Keep it same-origin: session cookies are SameSite=strict.
VITE_ADMIN_API_URL=/v1/

# CARTO basemaps key for map labels (free: https://carto.com/basemaps/apikey). Maps render without labels if unset.
VITE_CARTO_BASEMAPS_KEY=

# Dev server only: where /v1 requests are proxied to. Not bundled into the build.
ADMIN_API_PROXY_TARGET=http://127.0.0.1:16000
